{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Keycloak": {
    "Authority": "http://localhost:8080/realms/ai-cv-generator"
  },
  "DownstreamServices": {
    "Profile": "http://profile-service:8080",
    "Opportunity": "http://opportunity-service:8080",
    "Cv": "http://cv-service:8080",
    "Ai": "http://ai-service:8000"
  },
  "ReverseProxy": {
    "Routes": {
      "profile-route": {
        "ClusterId": "profile-cluster",
        "AuthorizationPolicy": "require-auth",
        "Match": { "Path": "/api/profile/{**catch-all}" },
        "Transforms": [
          { "PathRemovePrefix": "/api" }
        ]
      },
      "opportunity-route": {
        "ClusterId": "opportunity-cluster",
        "AuthorizationPolicy": "require-auth",
        "Match": { "Path": "/api/opportunity/{**catch-all}" },
        "Transforms": [
          { "PathRemovePrefix": "/api" }
        ]
      },
      "cv-route": {
        "ClusterId": "cv-cluster",
        "AuthorizationPolicy": "require-auth",
        "Match": { "Path": "/api/cvs/{**catch-all}" },
        "Transforms": [
          { "PathRemovePrefix": "/api" }
        ]
      },
      "cv-generate-route": {
        "ClusterId": "cv-cluster",
        "AuthorizationPolicy": "require-auth",
        "Match": { "Path": "/api/cv/generate" },
        "Transforms": [
          { "PathRemovePrefix": "/api" }
        ]
      },
      "cv-command-route": {
        "ClusterId": "cv-cluster",
        "AuthorizationPolicy": "require-auth",
        "Match": { "Path": "/api/cv/{**catch-all}" },
        "Transforms": [
          { "PathRemovePrefix": "/api" }
        ]
      },
      "files-route": {
        "ClusterId": "cv-cluster",
        "AuthorizationPolicy": "require-auth",
        "Match": { "Path": "/api/files/{**catch-all}" },
        "Transforms": [
          { "PathRemovePrefix": "/api" }
        ]
      }
    },
    "Clusters": {
      "profile-cluster": { "Destinations": { "dest1": { "Address": "http://profile-service:8080" } } },
      "opportunity-cluster": { "Destinations": { "dest1": { "Address": "http://opportunity-service:8080" } } },
      "cv-cluster": { "Destinations": { "dest1": { "Address": "http://cv-service:8080" } } }
    }
  }
}
