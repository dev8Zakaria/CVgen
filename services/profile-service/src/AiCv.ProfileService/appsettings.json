{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Service": {
    "Name": "profile-service",
    "PublicPort": 5101
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://localhost:5100"
    ]
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=aicv_profile;Username=aicv_user;Password=aicv_password"
  },
  "Keycloak": {
    "Authority": "http://localhost:8080/realms/ai-cv-generator",
    "Audience": "frontend-client",
    "RequireHttpsMetadata": false
  }
}
