# ===========================
# Frontend
# ===========================
FRONTEND_PORT=5173
KEYCLOAK_PORT=8080


VITE_AUTH_ENABLED=true
VITE_API_BASE_URL=http://localhost:5000/api
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=ai-cv-generator
VITE_KEYCLOAK_CLIENT_ID=frontend-client

# ===========================
# Backend (.NET)
# ===========================
BACKEND_PORT=5000
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://0.0.0.0:5000
KEYCLOAK_AUTHORITY=http://keycloak:8080/realms/ai-cv-generator
KEYCLOAK_AUDIENCE=frontend-client
AI_SERVICE_BASE_URL=http://ai-service:8000
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# ===========================
# AI Service
# ===========================
ENVIRONMENT=Development
AI_PROVIDER=gemini
AI_MODEL=gemini-3-flash-preview
GEMINI_API_KEY=

# ===========================
# PostgreSQL
# ===========================
POSTGRES_DB=aicv_db
POSTGRES_USER=aicv_user
POSTGRES_PASSWORD=aicv_password

# ===========================
# Keycloak
# ===========================
KEYCLOAK_PORT=8080
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# ===========================
# MinIO (Object Storage)
# ===========================
MINIO_USER=minioadmin
MINIO_PASSWORD=minioadmin

# ===========================
# Deployment / CI
# ===========================
COMPOSE_FILE=docker-compose.yml
ENV_FILE=.env
BACKUP_DIR=./backups
AI_HEALTH_URL=http://localhost:8000/health
